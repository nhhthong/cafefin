# Local development environment variables.
# Copy this file to `.env` (gitignored) and adjust if needed. This file is
# named "env.example" instead of the usual ".env.example" so it stays
# editable through normal tooling: this repo's permission settings block any
# path matching ".env*" from being read or edited, specifically to stop a
# real secrets file from being touched by mistake.
#
# The passwords below are randomly generated (not "change-me" placeholders)
# so a fresh `docker compose up` works out of the box, but they still only
# belong on your machine. This file is never pushed to any server.

# --- PostgreSQL ---
# Database name and the initial superuser Docker creates the container with.
POSTGRES_DB=cafefin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fpUAitp5cBABLr8Sqc4bp5Tdcxg7iG

# Dual DB user segregation (see db/init/01-users.sh and
# .claude/docs/specs/memory/infra.md): migration owns the schema (DDL),
# runtime is DML-only and is what cafefin-api actually connects as.
MIGRATION_DB_PASSWORD=wnSQh2GgudFeSZ2Bcd1y1XFrbJd2x5Q
RUNTIME_DB_PASSWORD=lz97SRVCJgTInamMPjFLDdeLZqioeU

# --- Frontend (non-secret build/runtime config only — never put
#     JWT/HMAC/database secrets here, Vite bakes these into the browser
#     bundle at build time) ---
# API base path the SPA calls; same-origin deployment uses /api/v1.
VITE_API_BASE_PATH=/api/v1
VITE_ENVIRONMENT_LABEL=local
